{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://estatehubapi-sshrwviq.b4a.run/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://estatehubapi-sshrwviq.b4a.run/uploads/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
