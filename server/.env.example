NODE_ENV=development
PORT=5001

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/estatehub

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d

# Cloudinary (image/video uploads) – leave blank to fall back to local uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nodemailer (email verification, forgot password) – optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EstateHub <no-reply@estatehub.dev>

# Google OAuth login – optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Frontend origin (CORS)
CLIENT_URL=http://localhost:5173

# Razorpay payments (token payments, optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
